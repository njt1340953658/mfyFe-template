{
  "name": "uni-preset-vue",
  "version": "1.0.0",
  "scripts": {
    "dev": "uni -p mp-weixin --mode development",
    "version": "npm version patch",
    "update-version": "node conf/update-version.js",
    "build:test": "uni build -p mp-weixin --mode test && npm run upload:test",
    "build:prod": "uni build -p mp-weixin --mode production && npm run upload:prod",
    "upload:test": "node conf/upload.js test",
    "upload:prod": "node conf/upload.js production",
    "dev:h5": "uni",
    "dev:h5:ssr": "uni --ssr",
    "build:h5": "uni build",
    "build:h5:ssr": "uni build --ssr",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
