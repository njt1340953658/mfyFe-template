    "@dcloudio/uni-mp-toutiao": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-xhs": "3.0.0-4080520251106001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-4080520251106001",
