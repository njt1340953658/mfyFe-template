# 开发环境配置

# 项目名称
VITE_APP_TITLE = "Hooks Admin 开发环境"

# 基础路径
VITE_PUBLIC_PATH = "/"

# API基础地址
VITE_BASE_API = "/api"

# 路由模式：hash | history
VITE_ROUTER_MODE = "history"

# 是否启用构建压缩
VITE_BUILD_COMPRESS = "none"

# 是否生成构建报告
VITE_REPORT = "false"

# 是否启用mock
VITE_USE_MOCK = "true"

# 开发服务器端口
VITE_PORT = "3000"

# 开发服务器地址
VITE_HOST = "0.0.0.0"

# 是否自动打开浏览器
VITE_OPEN = "false"