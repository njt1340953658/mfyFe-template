{
  "name": "jz-admin-vite",
  "version": "3.2.4",
  "description": "Vue3-JZYY后台管理系统",
  "author": "SunnyRun",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prepare": "husky install",
    "setup": "pnpm install --no-frozen-lockfile --force",
    "build:test": "vue-tsc --noEmit && vite build --mode development",
    "build:prod": "vue-tsc --noEmit && vite build",
    "preview:prod": "pnpm build:prod && vite preview",
    "lint": "eslint \"src/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,json,tsx,css,less,scss,vue,html,md}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.9.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.11.1",
    "js-base64": "^3.7.7",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.21",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^6.2.1",
    "pinia": "^2.3.1",
    "screenfull": "^6.0.2",
    "vue": "^3.5.15",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.30",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.23.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sass": "^1.72.0",
    "typescript": "5.4.3",
    "vite": "^6.4.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-eslint-parser": "^9.4.2",
    "vue-tsc": "^2.0.7"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,less,css,html}": [
      "prettier --write"
    ],
    "package.json": [
      "prettier --write"
    ],
    "{!(package)*.json,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ]
  },
  "eslintIgnore": [
    ".DS_Store",
    "node_modules",
    "dist",
    "dist-ssr",
    "*.local",
    "vite.config.ts",
    ".eslintrc.js",
    "prettier.config.js",
    "tsconfig.json",
    "README.md"
  ]
}
